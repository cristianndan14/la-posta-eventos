---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import HeroSection from '../components/HeroSection';
import StatsSection from '../components/StatsSection';
import MenuSection from '../components/MenuSection';
import ProcessSection from '../components/ProcessSection';
import CoverageSection from '../components/CoverageSection';
import TestimonialsSection from '../components/TestimonialsSection';
import FAQSection from '../components/FAQSection';
import Footer from '../components/Footer';

import heroAsado from '../assets/hero-asado.webp';
import logoLaposta from '../assets/logo-laposta.jpg';

// Import contact utilities
import { generateWhatsAppLink } from '../utils/contact';

// Optimize images at build time: resize + convert to webp
const heroImg = await getImage({ src: heroAsado, format: 'webp', width: 1920 });
const logoImg = await getImage({ src: logoLaposta, format: 'webp', width: 256 });
const logoSmall = await getImage({ src: logoLaposta, format: 'webp', width: 80 });

// Generate WhatsApp link
const whatsappLink = generateWhatsAppLink();
---

<Layout>
  <Header client:load logoSrc={logoSmall.src} />
  <main>
    <HeroSection heroSrc={heroImg.src} logoSrc={logoImg.src} />
    <StatsSection />
    <MenuSection />
    <ProcessSection />
    <CoverageSection />
    <TestimonialsSection />
    <FAQSection client:visible />
    <Footer logoSrc={logoSmall.src} />

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactanos por WhatsApp"
      class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#1ebe5d] text-white p-4 rounded-full shadow-lg hover:scale-110 transition-transform"
    >
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.76-1.48-1.76-.098-.145-.189-.15-.45-.052-.261.099-1.357.534-1.605.596-.248.062-.428.062-.606-.152-.178-.213-.686-.852-.84-1.143-.154-.29-.309-.25-.451-.025-1.617 1.897-1.271 3.623.098 5.07 1.369 1.447 3.8 2.951 9.267 1.336 1.05.335 1.987.251 2.731-.124.744-.374 1.148-.966 1.148-1.89 0-.524-.141-.915-.907-1.417z"/>
        <path d="M20.52 3.449C18.24 1.245 15.589 0 12.765 0 6.48 0 1.231 5.228 1.231 11.524c0 2.050.533 4.063 1.544 5.834L1.07 23.798l6.3-1.653c1.712.927 3.663 1.416 5.694 1.416h.006c6.287 0 11.536-5.228 11.536-11.524 0-3.083-1.295-5.974-3.646-8.102z"/>
      </svg>
    </a>
  </main>
</Layout>
